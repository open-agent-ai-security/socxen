      "bom-ref": "service:exabeam-mcp",
      "name": "Exabeam New-Scale MCP",
      "description": "External tool surface reached through the bundled connector: 20 tools (Threat Center, Search, detection rules, context tables) and NO containment capability. Registered via .mcp.json as a bundled MCP server.",
      "endpoint": "https://api.<region>.exabeam.cloud/mcp",
      "authenticated": true,
      "x-trust-boundary": true,
      "data": [
        {
          "flow": "inbound",
          "classification": "security-telemetry (alerts, events, cases — attacker-influenceable)"
        },
        {
          "flow": "outbound",
          "classification": "case-management actions (create/notes: free; dismiss/close: human-gated)"
        }
      ],
      "externalReferences": [
        {
          "type": "documentation",
          "url": "https://docs.exabeam.com/en/new-scale-soc-platform/all/administration-guide/get-started-with-the-new-scale-security-operations-platform/connect-to-exabeam-mcp-server.html"
        }
      ],
      "properties": [
        {
          "name": "mcp:toolCount",
          "value": "20"
        },
        {
          "name": "mcp:containmentCapability",
          "value": "none"
        },
        {
          "name": "mcp:transport",
          "value": "stdio bridge -> streamable-http"
        }
      ]
